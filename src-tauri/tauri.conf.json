{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hark",
  "version": "0.1.0",
  "identifier": "casmalia.hark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "hark!",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' hark: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/hweikel/hark/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRjYwMjU2RkYyQzRFQUEKUldTcVRpei9WZ0wyNzYxTnFQd29Ob21PbVBrZC82U3dCNVROV2d2MUZMbjFxM1dsaUFzNmwzYWgK"
    }
  }
}
